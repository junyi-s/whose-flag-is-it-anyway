# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Web (prefix VITE_)
VITE_SOCKET_URL=http://localhost:3001

# ─── Hardening (Phase 9.5) — all optional, defaults shown ────────────────

# LLM cost controls
LLM_ROOM_CALL_LIMIT=20          # max LLM calls per room lifetime (T1)
LLM_ROOM_COOLDOWN_MS=10000      # min ms between GENERATING transitions (T1)
LLM_MAX_CONCURRENT=3            # max simultaneous Anthropic requests (T2)
LLM_CALLS_PER_MIN=10            # global token-bucket rate (T1, T2)
LLM_DAILY_CALL_LIMIT=500        # daily ceiling; over limit → shuffle (T1, T2)
LLM_MAX_FLAGS=300               # skip LLM above this flag count (T3)

# Room / connection limits
MAX_ROOMS=200                   # total live rooms (T2, T4)
MAX_CONNS_PER_IP=30             # sockets per IP (T4)
ROOM_CREATE_LIMIT=5             # room:create per IP per window (T2)
ROOM_CREATE_WINDOW_MS=600000    # window for above, ms = 10 min (T2)
SOCKET_EVENT_BURST=30           # per-socket burst cap (T5)
SOCKET_EVENT_REFILL=5           # per-socket refill tokens/sec (T5)

# Room lifecycle
ROOM_IDLE_TTL_MS=1800000        # destroy after 30 min idle (T6)
ROOM_MAX_LIFETIME_MS=21600000   # destroy after 6 hr regardless (T6)
