{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @whose-flag/shared build && pnpm --filter @whose-flag/server build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @whose-flag/server start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
